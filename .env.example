# Copy to .env and fill in with the customer's own Supabase project values.
# Dashboard -> Project Settings -> API

VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR-ANON-PUBLISHABLE-KEY"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# Same values for the server side (SSR / Cloudflare Worker)
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR-ANON-PUBLISHABLE-KEY"
SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# Optional: only needed for privileged server-side operations. Never expose publicly.
# SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"
